parameters:
	level: 8

	paths:
		- src
		- tests

	excludePaths:
		- tests/fixtures/*

	ignoreErrors:
		# the class a rule looks for may be gone from the installed version; its name loads nothing
		-
			identifier: class.notFound
			paths:
				- src/IsGrantedForSecurityAnnotationRule.php
				- src/ValueResolverForArgumentResolverRule.php
