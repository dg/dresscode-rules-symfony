{
	"name": "dresscode/upgrade-symfony",
	"description": "👔 DressCode Upgrade for Symfony: upgrades code from Symfony 5.4 to 6, 7 and 8, SensioFrameworkExtraBundle annotations to attributes included, and reports the rest with what to write instead.",
	"keywords": ["symfony", "upgrade", "upgrading", "migration", "deprecations", "refactoring", "codemod", "annotations", "attributes", "framework-extra-bundle", "dresscode", "rector"],
	"homepage": "https://dresscode.run/upgrading-symfony",
	"type": "dresscode-plugin",
	"license": "MIT",
	"authors": [
		{
			"name": "David Grudl",
			"homepage": "https://davidgrudl.com"
		}
	],
	"require": {
		"php": "8.4 - 8.6",
		"dresscode/dresscode": "^1.2"
	},
	"require-dev": {
		"nette/phpstan-rules": "^1.0",
		"nette/tester": "^2.6",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.2",
		"symfony/cache": "^8.1",
		"symfony/config": "^8.1",
		"symfony/console": "^8.1",
		"symfony/dependency-injection": "^8.1",
		"symfony/doctrine-bridge": "^8.1",
		"symfony/error-handler": "^8.1",
		"symfony/event-dispatcher": "^8.1",
		"symfony/expression-language": "^8.1",
		"symfony/filesystem": "^8.1",
		"symfony/finder": "^8.1",
		"symfony/form": "^8.1",
		"symfony/framework-bundle": "^8.1",
		"symfony/http-client": "^8.1",
		"symfony/http-foundation": "^8.1",
		"symfony/http-kernel": "^8.1",
		"symfony/intl": "^8.1",
		"symfony/json-streamer": "^8.1",
		"symfony/lock": "^8.1",
		"symfony/mailer": "^8.1",
		"symfony/messenger": "^8.1",
		"symfony/mime": "^8.1",
		"symfony/monolog-bridge": "^8.1",
		"symfony/notifier": "^8.1",
		"symfony/options-resolver": "^8.1",
		"symfony/password-hasher": "^8.1",
		"symfony/property-access": "^8.1",
		"symfony/property-info": "^8.1",
		"symfony/routing": "^8.1",
		"symfony/security-bundle": "^8.1",
		"symfony/security-core": "^8.1",
		"symfony/security-csrf": "^8.1",
		"symfony/security-http": "^8.1",
		"symfony/serializer": "^8.1",
		"symfony/string": "^8.1",
		"symfony/translation": "^8.1",
		"symfony/twig-bridge": "^8.1",
		"symfony/type-info": "^8.1",
		"symfony/validator": "^8.1",
		"symfony/var-dumper": "^8.1",
		"symfony/workflow": "^8.1",
		"twig/twig": "^3.21",
		"symfony/amqp-messenger": "^8.1",
		"symfony/doctrine-messenger": "^8.1",
		"symfony/redis-messenger": "^8.1",
		"symfony/var-exporter": "^8.1"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"autoload": {
		"classmap": ["src/"],
		"psr-4": {
			"DressCodeUpgrade\\Symfony\\": "src"
		}
	},
	"scripts": {
		"tester": "tester tests -s",
		"phpstan": "phpstan analyse"
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true
		},
		"platform": {
			"ext-amqp": "2.1",
			"ext-redis": "6.2"
		}
	},
	"extra": {
		"branch-alias": {
			"dev-master": "1.0-dev"
		},
		"dresscode": {
			"plugin": "DressCodeUpgrade\\Symfony\\Plugin",
			"upgrading-dir": "upgrading",
			"packages": [
				"symfony/cache",
				"symfony/config",
				"symfony/console",
				"symfony/dependency-injection",
				"symfony/doctrine-bridge",
				"symfony/event-dispatcher",
				"symfony/expression-language",
				"symfony/filesystem",
				"symfony/finder",
				"symfony/form",
				"symfony/framework-bundle",
				"symfony/http-client",
				"symfony/http-foundation",
				"symfony/http-kernel",
				"symfony/intl",
				"symfony/json-streamer",
				"symfony/lock",
				"symfony/mailer",
				"symfony/messenger",
				"symfony/mime",
				"symfony/monolog-bridge",
				"symfony/notifier",
				"symfony/options-resolver",
				"symfony/property-access",
				"symfony/property-info",
				"symfony/routing",
				"symfony/security-bundle",
				"symfony/security-core",
				"symfony/security-csrf",
				"symfony/security-http",
				"symfony/serializer",
				"symfony/string",
				"symfony/translation",
				"symfony/twig-bridge",
				"symfony/type-info",
				"symfony/validator",
				"symfony/var-dumper",
				"symfony/var-exporter",
				"symfony/workflow"
			]
		}
	}
}
