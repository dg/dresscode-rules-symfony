{
	"name": "dresscode/upgrade-symfony",
	"description": "👔 DressCode Upgrade for Symfony: upgrades code from Symfony 5.4 to 6, 7 and 8, SensioFrameworkExtraBundle annotations to attributes included, and reports the rest with what to write instead.",
	"keywords": ["symfony", "upgrade", "upgrading", "migration", "deprecations", "refactoring", "codemod", "annotations", "attributes", "framework-extra-bundle", "dresscode", "rector"],
	"homepage": "https://dresscode.run/upgrading-symfony",
	"type": "dresscode-plugin",
	"license": "MIT",
	"authors": [
		{
			"name": "David Grudl",
			"homepage": "https://davidgrudl.com"
		}
	],
	"require": {
		"php": "8.4 - 8.6",
		"dresscode/dresscode": "^1.2"
	},
	"require-dev": {
		"nette/phpstan-rules": "^1.0",
		"nette/tester": "^2.6",
		"phpstan/extension-installer": "^1.4",
		"phpstan/phpstan": "^2.2",
		"symfony/console": "^8.1",
		"symfony/dependency-injection": "^8.1",
		"symfony/error-handler": "^8.1",
		"symfony/event-dispatcher": "^8.1",
		"symfony/http-foundation": "^8.1",
		"symfony/http-kernel": "^8.1",
		"symfony/routing": "^8.1"
	},
	"minimum-stability": "dev",
	"prefer-stable": true,
	"autoload": {
		"classmap": ["src/"],
		"psr-4": {
			"DressCodeUpgrade\\Symfony\\": "src"
		}
	},
	"scripts": {
		"tester": "tester tests -s",
		"phpstan": "phpstan analyse"
	},
	"config": {
		"allow-plugins": {
			"phpstan/extension-installer": true
		}
	},
	"extra": {
		"branch-alias": {
			"dev-master": "1.0-dev"
		},
		"dresscode": {
			"plugin": "DressCodeUpgrade\\Symfony\\Plugin",
			"upgrading-dir": "upgrading",
			"packages": [
				"symfony/console",
				"symfony/dependency-injection",
				"symfony/event-dispatcher",
				"symfony/http-foundation",
				"symfony/http-kernel",
				"symfony/routing"
			]
		}
	}
}
