<?php

namespace App\Serializer;

use Symfony\Component\Serializer\Annotation as Serializer;
use Symfony\Component\Serializer\Attribute\Groups;
use Symfony\Component\Serializer\Attribute\SerializedName;
use Symfony\Component\Serializer\Attribute\Context;
use Symfony\Component\Serializer\Attribute\DiscriminatorMap;
use Symfony\Component\Serializer\Attribute\Ignore;
use Symfony\Component\Serializer\Attribute\MaxDepth;
use Symfony\Component\Serializer\CacheWarmer\CompiledClassMetadataCacheWarmer;
use Symfony\Component\Serializer\Context\Encoder\CsvEncoderContextBuilder;
use Symfony\Component\Serializer\Context\Normalizer\ObjectNormalizerContextBuilder;
use Symfony\Component\Serializer\Encoder\CsvEncoder;
use Symfony\Component\Serializer\Encoder\JsonDecode;
use Symfony\Component\Serializer\Mapping\AttributeMetadata;
use Symfony\Component\Serializer\Mapping\ClassMetadataInterface;
use Symfony\Component\Serializer\Mapping\Factory\ClassMetadataFactory;
use Symfony\Component\Serializer\Mapping\Factory\ClassMetadataFactoryCompiler;
use Symfony\Component\Serializer\Mapping\Factory\CompiledClassMetadataFactory;
use Symfony\Component\Serializer\Mapping\Loader\AttributeLoader;
use Symfony\Component\Serializer\NameConverter\NameConverterInterface;
use Symfony\Component\Serializer\Normalizer\AbstractNormalizer;
use Symfony\Component\Serializer\Normalizer\ArrayDenormalizer;
use Symfony\Component\Serializer\Normalizer\CacheableSupportsMethodInterface;
use Symfony\Component\Serializer\Normalizer\DenormalizerInterface;
use Symfony\Component\Serializer\Normalizer\DenormalizerAwareInterface;
use Symfony\Component\Serializer\Normalizer\DenormalizerAwareTrait;
use Symfony\Component\Serializer\Normalizer\NormalizerInterface;
use Symfony\Component\Serializer\Serializer as SymfonySerializer;


#[DiscriminatorMap(typeProperty: 'type', mapping: ['topic' => 'App\Serializer\Topic'])]
abstract class Post
{
}


class Topic extends Post
{
	#[Context(normalizationContext: ['datetime_format' => 'Y-m-d'], groups: ['detail'])]
	#[Ignore]
	public ?\DateTimeImmutable $createdAt = null;

	#[Groups(['list', 'detail'])]
	#[SerializedName('topic_title')]
	public string $title = '';

	#[MaxDepth(2)]
	public array $children = [];

	#[Groups(['detail'])]
	#[SerializedName('body_text')]
	public string $body = '';
}


class TopicNormalizer implements NormalizerInterface, CacheableSupportsMethodInterface
{
	public function normalize(mixed $data, ?string $format = null, array $context = []): array
	{
		return ['title' => $data->title];
	}


	public function supportsNormalization(mixed $data, ?string $format = null, array $context = []): bool
	{
		return $data instanceof Topic;
	}


	public function hasCacheableSupportsMethod(): bool
	{
		return true;
	}
}


class TopicDenormalizer implements DenormalizerInterface, DenormalizerAwareInterface
{
	use DenormalizerAwareTrait;

	public function denormalize(mixed $data, string $type, ?string $format = null, array $context = []): mixed
	{
		return new Topic;
	}


	public function supportsDenormalization(mixed $data, string $type, ?string $format = null, array $context = []): bool
	{
		return $type === Topic::class;
	}
}


abstract class BaseTopicNormalizer extends AbstractNormalizer
{
	public function hasCacheableSupportsMethod(): bool
	{
		return parent::hasCacheableSupportsMethod();
	}
}


class SnakeCaseConverter implements NameConverterInterface
{
	public function normalize(string $propertyName, ?string $class = null, ?string $format = null, array $context = []): string
	{
		return strtolower($propertyName);
	}


	public function denormalize(string $propertyName, ?string $class = null, ?string $format = null, array $context = []): string
	{
		return $propertyName;
	}
}


class LegacyJsonDecode extends JsonDecode
{
	public function hasSerializer(): bool
	{
		return $this->serializer !== null;
	}
}


function configure(SymfonySerializer $serializer, ?\Doctrine\Common\Annotations\Reader $reader, ClassMetadataInterface $classMetadata): void
{
	$arrayDenormalizer = new ArrayDenormalizer;
	$arrayDenormalizer->setDenormalizer($serializer);

	$factory = new ClassMetadataFactory(new AttributeLoader());
	$factory = new ClassMetadataFactory(new AttributeLoader);
	$factory = new ClassMetadataFactory(new AttributeLoader());
	$loader = new AttributeLoader;
	foreach ($loader->loadAnnotations(new \ReflectionClass(Topic::class)) as $annotation) {
	}

	$attributeMetadata = new AttributeMetadata('title');
	$attributeMetadata->setSerializedName(null);
	$attributeMetadata->setSerializedName('topic_title');
	$classMetadata->setClassDiscriminatorMapping(null);

	$context = (new ObjectNormalizerContextBuilder)
		->withDefaultConstructorArguments([Topic::class => ['title' => '']])
		->toArray();

	$csvContext = (new CsvEncoderContextBuilder)
		->withEscapeChar('\\')
		->toArray();
	$csv = (new CsvEncoder)->encode([], 'csv', [CsvEncoder::ESCAPE_CHAR_KEY => '\\']);

	$compiled = new CompiledClassMetadataFactory(__DIR__ . '/metadata.php', $factory);
	$warmer = new CompiledClassMetadataCacheWarmer([], $factory, new ClassMetadataFactoryCompiler, new \Symfony\Component\Filesystem\Filesystem);

	$groups = new Groups(['list']);
	$names = $groups->groups;
	$property = new \ReflectionProperty(Topic::class, 'body');
	foreach ($property->getAttributes(SerializedName::class) as $attribute) {
		$name = $attribute->newInstance()->serializedName;
	}
	$maxDepth = (new MaxDepth(2))->maxDepth;
	$map = new \Symfony\Component\Serializer\Attribute\DiscriminatorMap('type', ['topic' => Topic::class]);
	$typeProperty = $map->typeProperty;
	$mapping = $map?->mapping;
}
