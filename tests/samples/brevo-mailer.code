<?php

namespace App\Mail;

use Psr\Log\LoggerInterface;
use Symfony\Component\Mailer\Bridge\Sendinblue\Transport\SendinblueApiTransport;
use Symfony\Component\Mailer\Bridge\Sendinblue\Transport\SendinblueSmtpTransport;
use Symfony\Component\Mailer\Bridge\Sendinblue\Transport\SendinblueTransportFactory;
use Symfony\Component\Mailer\Transport\Dsn;
use Symfony\Component\Mailer\Transport\TransportInterface;
use Symfony\Contracts\HttpClient\HttpClientInterface;


class TransportProvider
{
	public function __construct(
		private HttpClientInterface $client,
		private LoggerInterface $logger,
		private ?SendinblueTransportFactory $factory = null,
	) {
	}


	public function createApi(string $key): SendinblueApiTransport
	{
		$transport = new SendinblueApiTransport($key, $this->client, null, $this->logger);
		$transport->setPort(8080);
		return $transport;
	}


	public function createSmtp(string $user, string $password): TransportInterface
	{
		return new SendinblueSmtpTransport($user, $password, null, $this->logger);
	}


	public function createFromDsn(string $dsn): ?TransportInterface
	{
		return $this->factory?->create(Dsn::fromString($dsn));
	}


	public function isApi(TransportInterface $transport): bool
	{
		return $transport instanceof SendinblueApiTransport;
	}
}
