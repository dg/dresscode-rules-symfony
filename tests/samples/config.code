<?php

namespace App\DependencyInjection;

use Symfony\Component\Config\Builder\ConfigBuilderGenerator;
use Symfony\Component\Config\Builder\ConfigBuilderInterface;
use Symfony\Component\Config\Definition\BaseNode;
use Symfony\Component\Config\Definition\Builder\NodeBuilder;
use Symfony\Component\Config\Definition\Builder\TreeBuilder;
use Symfony\Component\Config\Definition\ConfigurationInterface;


class Configuration implements ConfigurationInterface
{
	public function getConfigTreeBuilder(): TreeBuilder
	{
		$treeBuilder = new TreeBuilder('acme');
		$treeBuilder->getRootNode()
			->children()
				->scalarNode('host')->setDeprecated()->end()
				->scalarNode('port')->setDeprecated('The "%node%" option is deprecated, use "dsn".')->end()
				->scalarNode('user')->setDeprecated('acme/bundle', '1.2')->end()
				->scalarNode('dsn')->setDeprecated('acme/bundle', '1.2', 'The "%node%" option is not used.')->end()
			->end();

		return $treeBuilder;
	}
}


class AcmeNodeBuilder extends NodeBuilder
{
	public function detach(): static
	{
		return $this->setParent();
	}
}


class NodeDescriber
{
	public function describe(BaseNode $node, ?BaseNode $child): string
	{
		$node->setDeprecated(null);
		$node->setDeprecated('Do not use.');

		return $node->getDeprecationMessage($node->getName(), $node->getPath())
			. $child->getDeprecationMessage('child', 'acme.child')
			. $node->getDeprecationMessage();
	}


	public function build(ConfigBuilderInterface $builder): array
	{
		(new NodeBuilder)->setParent();
		(new NodeBuilder)->setParent(null);
		new ConfigBuilderGenerator(__DIR__);

		return $builder->toArray();
	}
}
