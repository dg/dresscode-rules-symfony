<?php

namespace App\Controller;

use Sensio\Bundle\FrameworkExtraBundle\Configuration\Security;
use Symfony\Component\HttpFoundation\Response;

/**
 * The administration.
 * @Security("is_granted('ROLE_ADMIN')")
 */
class AdminController
{
	/**
	 * @Security("is_granted('ROLE_EDITOR') and is_granted('EDIT', post)", message="Posts are edited by their authors", statusCode=404)
	 */
	public function edit(Post $post): Response
	{
		return new Response;
	}


	/**
	 * Lists the posts.
	 *
	 * @Security("is_granted('ROLE_USER') or is_granted('ROLE_GUEST')")
	 */
	public function list(): Response
	{
		return new Response;
	}


	/** @Security("user == post.getAuthor()") */
	public function delete(Post $post): Response
	{
		return new Response;
	}


	#[Security("is_granted('ROLE_ADMIN')")]
	public function purge(): Response
	{
		return new Response;
	}


	#[Security("is_granted('ROLE_ADMIN') && is_granted('ROLE_OWNER')")]
	public function drop(): Response
	{
		return new Response;
	}


	#[Security('is_granted("ROLE_ADMIN") and is_granted("ROLE_OWNER")'), Deprecated]
	public function truncate(): Response
	{
		return new Response;
	}
}
