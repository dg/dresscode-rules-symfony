package: symfony/security-http
group: deprecations

since 8.1:
	replacedCalls:
		'Symfony\Component\Security\Http\Authentication\AuthenticatorManager::__construct($authenticators, $tokenStorage, $eventDispatcher, $firewallName, $logger, bool $eraseCredentials, ...)': 'new \Symfony\Component\Security\Http\Authentication\AuthenticatorManager($authenticators, $tokenStorage, $eventDispatcher, $firewallName, $logger, ...)'

since 7.4:
	replacedCalls:
		'Symfony\Component\Security\Http\RememberMe\RememberMeDetails::__construct($userFqcn, $userIdentifier, $expires, $value)': 'new \Symfony\Component\Security\Http\RememberMe\RememberMeDetails($userIdentifier, $expires, $value)'

	forbiddenMembers:
		Symfony\Component\Security\Http\RememberMe\RememberMeDetails::getUserFqcn: 'there is no replacement, the remember-me cookie no longer holds the class of the user'
		Symfony\Component\Security\Http\Firewall\AbstractListener::__invoke: 'there is no replacement, the firewall calls `supports()` and `authenticate()` of the listener itself'

since 7.2:
	replacedCalls:
		'Symfony\Component\Security\Http\Authenticator\RememberMeAuthenticator::__construct($rememberMeHandler, string $secret, $tokenStorage, ...)': 'new \Symfony\Component\Security\Http\Authenticator\RememberMeAuthenticator($rememberMeHandler, $tokenStorage, ...)'

since 6.3:
	replacedCalls:
		'Symfony\Component\Security\Http\RememberMe\PersistentRememberMeHandler::__construct($tokenProvider, string $secret, $userProvider, ...)': 'new \Symfony\Component\Security\Http\RememberMe\PersistentRememberMeHandler($tokenProvider, $userProvider, ...)'

since 6.2:
	attributeForAnnotation:
		Sensio\Bundle\FrameworkExtraBundle\Configuration\IsGranted: Symfony\Component\Security\Http\Attribute\IsGranted

since 6.0:
	replacedClasses:
		Symfony\Component\Security\Http\Authenticator\Passport\PassportInterface: Symfony\Component\Security\Http\Authenticator\Passport\Passport
		Symfony\Component\Security\Http\Authenticator\Passport\UserPassportInterface: Symfony\Component\Security\Http\Authenticator\Passport\Passport

	replacedMembers:
		Symfony\Component\Security\Http\Authentication\DefaultAuthenticationSuccessHandler::getProviderKey: getFirewallName
		Symfony\Component\Security\Http\Authentication\DefaultAuthenticationSuccessHandler::setProviderKey: setFirewallName
		Symfony\Component\Security\Http\Authenticator\AuthenticatorInterface::createAuthenticatedToken: createToken

	forbiddenClasses:
		Symfony\Component\Security\Http\Authenticator\Passport\PassportTrait: 'extend `Symfony\Component\Security\Http\Authenticator\Passport\Passport`, which has the badges and the attributes the trait gave'
		Symfony\Component\Security\Http\EntryPoint\RetryAuthenticationEntryPoint: 'there is no replacement, `ChannelListener` redirects to the required scheme itself; drop the entry point'
		Symfony\Component\Security\Http\EntryPoint\FormAuthenticationEntryPoint: 'use `Symfony\Component\Security\Http\Authenticator\FormLoginAuthenticator`, which is the entry point of the form login'
		Symfony\Component\Security\Http\EntryPoint\BasicAuthenticationEntryPoint: 'use `Symfony\Component\Security\Http\Authenticator\HttpBasicAuthenticator`, which is the entry point of the HTTP basic login'
		Symfony\Component\Security\Http\RememberMe\RememberMeServicesInterface: 'implement `Symfony\Component\Security\Http\RememberMe\RememberMeHandlerInterface`, which the remember-me authenticator uses'
		Symfony\Component\Security\Http\RememberMe\AbstractRememberMeServices: 'extend `Symfony\Component\Security\Http\RememberMe\AbstractRememberMeHandler`, which the remember-me authenticator uses'
		Symfony\Component\Security\Http\RememberMe\TokenBasedRememberMeServices: 'use `Symfony\Component\Security\Http\RememberMe\SignatureRememberMeHandler`, which the remember-me authenticator uses'
		Symfony\Component\Security\Http\RememberMe\PersistentTokenBasedRememberMeServices: 'use `Symfony\Component\Security\Http\RememberMe\PersistentRememberMeHandler`, which the remember-me authenticator uses'
		Symfony\Component\Security\Http\EventListener\RememberMeLogoutListener: 'there is no replacement, the remember-me handler clears its cookie on logout itself; drop the listener'
		Symfony\Component\Security\Http\Logout\LogoutHandlerInterface: 'register a listener of `Symfony\Component\Security\Http\Event\LogoutEvent`, which has the request, the response and the token'
		Symfony\Component\Security\Http\Logout\LogoutSuccessHandlerInterface: 'register a listener of `Symfony\Component\Security\Http\Event\LogoutEvent` and set the response on the event'
		Symfony\Component\Security\Http\Logout\DefaultLogoutSuccessHandler: 'use `Symfony\Component\Security\Http\EventListener\DefaultLogoutListener`, a listener of `LogoutEvent`'
		Symfony\Component\Security\Http\Logout\CookieClearingLogoutHandler: 'use `Symfony\Component\Security\Http\EventListener\CookieClearingLogoutListener`, a listener of `LogoutEvent`'
		Symfony\Component\Security\Http\Logout\SessionLogoutHandler: 'use `Symfony\Component\Security\Http\EventListener\SessionLogoutListener`, a listener of `LogoutEvent`'
		Symfony\Component\Security\Http\Logout\CsrfTokenClearingLogoutHandler: 'use `Symfony\Component\Security\Http\EventListener\CsrfTokenClearingLogoutListener`, a listener of `LogoutEvent`'
		Symfony\Component\Security\Http\Event\DeauthenticatedEvent: 'use `Symfony\Component\Security\Http\Event\TokenDeauthenticatedEvent`, which has the original token and the request but no refreshed token'
		Symfony\Component\Security\Http\Firewall\AbstractAuthenticationListener: 'there is no replacement, the authenticator system logs users in; extend `Symfony\Component\Security\Http\Authenticator\AbstractAuthenticator`'
		Symfony\Component\Security\Http\Firewall\AbstractPreAuthenticatedListener: 'there is no replacement, the authenticator system logs users in; extend `Symfony\Component\Security\Http\Authenticator\AbstractAuthenticator`'
		Symfony\Component\Security\Http\Firewall\AnonymousAuthenticationListener: 'there is no replacement, a visitor who is not logged in has no token; drop the listener'
		Symfony\Component\Security\Http\Firewall\BasicAuthenticationListener: 'use `Symfony\Component\Security\Http\Authenticator\HttpBasicAuthenticator`'
		Symfony\Component\Security\Http\Firewall\RememberMeListener: 'use `Symfony\Component\Security\Http\Authenticator\RememberMeAuthenticator`'
		Symfony\Component\Security\Http\Firewall\RemoteUserAuthenticationListener: 'use `Symfony\Component\Security\Http\Authenticator\RemoteUserAuthenticator`'
		Symfony\Component\Security\Http\Firewall\UsernamePasswordFormAuthenticationListener: 'use `Symfony\Component\Security\Http\Authenticator\FormLoginAuthenticator`'
		Symfony\Component\Security\Http\Firewall\UsernamePasswordJsonAuthenticationListener: 'use `Symfony\Component\Security\Http\Authenticator\JsonLoginAuthenticator`'
		Symfony\Component\Security\Http\Firewall\X509AuthenticationListener: 'use `Symfony\Component\Security\Http\Authenticator\X509Authenticator`'
