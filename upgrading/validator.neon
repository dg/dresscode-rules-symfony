package: symfony/validator
group: deprecations

since 8.2:
	forbiddenMembers:
		Symfony\Component\Validator\Constraints\GroupSequence::$cascadedGroup: 'there is no replacement, the validator has not read it since 2014; drop the setting'

since 8.1:
	forbiddenMembers:
		'Symfony\Component\Validator\ConstraintValidatorInterface::validate($value, $constraint)': 'call `validateInContext()`, which takes the execution context too; in a `ConstraintValidatorTestCase` call `$this->validate()`'
		'Symfony\Component\Validator\ConstraintValidatorInterface::initialize($context)': 'call `validateInContext()`, which takes the execution context together with the value and the constraint'

since 7.3:
	replacedCalls:
		'Symfony\Component\Validator\Constraints\Bic::__construct(array $options)': 'new \Symfony\Component\Validator\Constraints\Bic(...$options)'
		'Symfony\Component\Validator\Constraints\Blank::__construct(array $options)': 'new \Symfony\Component\Validator\Constraints\Blank(...$options)'
		'Symfony\Component\Validator\Constraints\Cidr::__construct(array $options)': 'new \Symfony\Component\Validator\Constraints\Cidr(...$options)'
		'Symfony\Component\Validator\Constraints\Choice::__construct(list $choices, ...)': 'new \Symfony\Component\Validator\Constraints\Choice(choices: $choices, ...)'
		'Symfony\Component\Validator\Constraints\Choice::__construct(array $options)': 'new \Symfony\Component\Validator\Constraints\Choice(...$options)'
		'Symfony\Component\Validator\Constraints\Count::__construct(array $options)': 'new \Symfony\Component\Validator\Constraints\Count(...$options)'
