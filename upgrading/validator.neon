since 7.1:
	forbiddenMembers:
		Symfony\Component\Validator\Constraints\Bic::INVALID_BANK_CODE_ERROR: 'there is no replacement, ISO 9362 puts no restriction on the characters of a bank code and the validator never reports it'

since 6.4:
	replacedClasses:
		Symfony\Component\Validator\Mapping\Loader\AnnotationLoader: Symfony\Component\Validator\Mapping\Loader\AttributeLoader

	replacedMembers:
		Symfony\Component\Validator\ValidatorBuilder::enableAnnotationMapping: enableAttributeMapping
		Symfony\Component\Validator\ValidatorBuilder::disableAnnotationMapping: disableAttributeMapping

	forbiddenMembers:
		Symfony\Component\Validator\ValidatorBuilder::setDoctrineAnnotationReader: 'there is no replacement, constraints are read from attributes and never from Doctrine annotations; drop the call'
		Symfony\Component\Validator\ValidatorBuilder::addDefaultDoctrineAnnotationReader: 'there is no replacement, constraints are read from attributes and never from Doctrine annotations; drop the call'

	attributeForAnnotation:
		Symfony\Component\Validator\Constraints\*: Symfony\Component\Validator\Constraints\*
		Symfony\Component\Validator\Constraints\ExpressionLanguageSyntax: Symfony\Component\Validator\Constraints\ExpressionSyntax

since 6.2:
	replacedMembers:
		Symfony\Component\Validator\Constraints\Email::VALIDATION_MODE_LOOSE: VALIDATION_MODE_HTML5

since 6.1:
	replacedClasses:
		Symfony\Component\Validator\Constraints\ExpressionLanguageSyntax: Symfony\Component\Validator\Constraints\ExpressionSyntax
		Symfony\Component\Validator\Constraints\ExpressionLanguageSyntaxValidator: Symfony\Component\Validator\Constraints\ExpressionSyntaxValidator

	replacedMembers:
		Symfony\Component\Validator\Constraints\ExpressionLanguageSyntax::EXPRESSION_LANGUAGE_SYNTAX_ERROR: Symfony\Component\Validator\Constraints\ExpressionSyntax::EXPRESSION_SYNTAX_ERROR

	forbiddenMembers:
		Symfony\Component\Validator\Constraint::$errorNames: 'read `ERROR_NAMES`, the protected constant each constraint declares in its place'
		Symfony\Component\Validator\Constraints\Ip::$versions: 'read `VERSIONS`, the protected constant holding the same list'

since 6.0:
	replacedCalls:
		'Symfony\Component\Validator\ValidatorBuilder::enableAnnotationMapping(true)': 'enableAnnotationMapping()'
		'Symfony\Component\Validator\ValidatorBuilder::enableAnnotationMapping($reader)': 'enableAnnotationMapping()->setDoctrineAnnotationReader($reader)'

	forbiddenClasses:
		Symfony\Component\Validator\Constraints\NumberConstraintTrait: 'there is no replacement, it served the number constraints of Symfony itself'
