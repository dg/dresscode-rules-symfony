package: symfony/framework-bundle
group: deprecations

since 7.4:
	replacedClasses:
		Symfony\Bundle\FrameworkBundle\Command\WorkflowDumpCommand: Symfony\Component\Workflow\Command\WorkflowDumpCommand

since 7.3:
	replacedClasses:
		Symfony\Bundle\FrameworkBundle\Command\TranslationUpdateCommand: Symfony\Bundle\FrameworkBundle\Command\TranslationExtractCommand

since 6.4:
	replacedClasses:
		Symfony\Bundle\FrameworkBundle\Routing\AnnotatedRouteControllerLoader: Symfony\Bundle\FrameworkBundle\Routing\AttributeRouteControllerLoader
		Symfony\Bundle\FrameworkBundle\DependencyInjection\Compiler\AddExpressionLanguageProvidersPass: Symfony\Component\Routing\DependencyInjection\AddExpressionLanguageProvidersPass
		Symfony\Bundle\FrameworkBundle\DependencyInjection\Compiler\DataCollectorTranslatorPass: Symfony\Component\Translation\DependencyInjection\DataCollectorTranslatorPass
		Symfony\Bundle\FrameworkBundle\DependencyInjection\Compiler\LoggingTranslatorPass: Symfony\Component\Translation\DependencyInjection\LoggingTranslatorPass
		Symfony\Bundle\FrameworkBundle\DependencyInjection\Compiler\WorkflowGuardListenerPass: Symfony\Component\Workflow\DependencyInjection\WorkflowGuardListenerPass

	forbiddenClasses:
		Symfony\Bundle\FrameworkBundle\DependencyInjection\Compiler\EnableLoggerDebugModePass: 'pass `debug: true` to `Symfony\Component\HttpKernel\Log\Logger::__construct()`'

	forbiddenMembers:
		Symfony\Bundle\FrameworkBundle\DependencyInjection\Compiler\AddDebugLogProcessorPass::configureLogger: 'register `Symfony\Component\HttpKernel\Log\DebugLoggerConfigurator::pushDebugLogger()` as the configurator of the logger service'

since 6.2:
	replacedMembers:
		Symfony\Bundle\FrameworkBundle\Controller\AbstractController::renderForm: render

since 6.0:
	forbiddenMembers:
		Symfony\Bundle\FrameworkBundle\Controller\AbstractController::get: 'use a constructor or action argument typed with the service, or override `getSubscribedServices()` and call `$this->container->get()`'
		Symfony\Bundle\FrameworkBundle\Controller\AbstractController::has: 'use a nullable constructor or action argument, or override `getSubscribedServices()` and call `$this->container->has()`'
		Symfony\Bundle\FrameworkBundle\Controller\AbstractController::getDoctrine: 'use a constructor or action argument typed with `Doctrine\Persistence\ManagerRegistry`'
		Symfony\Bundle\FrameworkBundle\Controller\AbstractController::dispatchMessage: 'use a constructor or action argument typed with `Symfony\Component\Messenger\MessageBusInterface` and call its `dispatch()`'
		Symfony\Bundle\FrameworkBundle\Test\KernelTestCase::$container: 'call `getContainer()`, which boots the kernel when needed and returns the test service container'
